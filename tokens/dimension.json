{
  "$description": "Espaço, raio, borda, elevação, ícone, toque e movimento (decisões 0010, 0011, 0012).",
  "space": { "$type": "dimension", "0": { "$value": "0px" }, "2": { "$value": "2px" }, "4": { "$value": "4px" }, "8": { "$value": "8px" }, "12": { "$value": "12px" }, "16": { "$value": "16px" }, "20": { "$value": "20px" }, "24": { "$value": "24px" }, "32": { "$value": "32px" }, "48": { "$value": "48px" } },
